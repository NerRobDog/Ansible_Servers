{# Build the full outbounds list (user outbounds + auto urltest if 2+ + direct)
   as a single Python list, then dump it once via to_nice_json. This avoids the
   single-outbound trailing-comma trap that broke JSON validation in PR review. -#}
{%- set user_outbounds = sing_box_proxy_config.outbounds | default([]) -%}
{%- set rendered_outbounds = [] -%}
{%- for ob in user_outbounds -%}
{%-   set _ = rendered_outbounds.append(ob) -%}
{%- endfor -%}
{%- if user_outbounds | length > 1 -%}
{%-   set _ = rendered_outbounds.append({
        "type": "urltest",
        "tag": "auto",
        "outbounds": user_outbounds | map(attribute='tag') | list,
        "url": "https://www.gstatic.com/generate_204",
        "interval": "3m",
      }) -%}
{%- endif -%}
{%- set _ = rendered_outbounds.append({"type": "direct", "tag": "direct"}) -%}
{# route.final selection: explicit -> auto (when many) -> single outbound tag -> direct -#}
{%- set route_final_raw = sing_box_proxy_config.route_final | default('') -%}
{%- if route_final_raw | length > 0 -%}
{%-   set route_final = route_final_raw -%}
{%- elif user_outbounds | length > 1 -%}
{%-   set route_final = 'auto' -%}
{%- elif user_outbounds | length == 1 -%}
{%-   set route_final = user_outbounds[0].tag -%}
{%- else -%}
{%-   set route_final = 'direct' -%}
{%- endif -%}
{
  "log": {
    "level": "{{ sing_box_proxy_config.log_level | default(sing_box_proxy_log_level) }}",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-local",
      "listen": "{{ sing_box_proxy_inbound_listen }}",
      "listen_port": {{ sing_box_proxy_inbound_port | int }},
      "sniff": true
    }
  ],
  "outbounds": {{ rendered_outbounds | to_nice_json(indent=2) | indent(2) }},
  "route": {
    "auto_detect_interface": true,
    "final": "{{ route_final }}",
    "rules": []
  }
}
