{# Managed by Ansible role yusic_stack. Do not edit by hand — changes will be overwritten.
   Source of truth: roles/yusic_stack/defaults/main.yml + group_vars/yusic_stack/{vars,vault}.yml.
   See yusic-pdh in beads for context (dropped dead http://100.105.91.72:8091 relay). #}
# === Telegram core ===
BOT_TOKEN={{ yusic_stack_bot_token }}
API_ID={{ yusic_stack_api_id }}
API_HASH={{ yusic_stack_api_hash }}
INLINE_CACHE_CHAT_ID={{ yusic_stack_inline_cache_chat_id }}
ENABLED_PROVIDERS={{ yusic_stack_enabled_providers }}

# === Mini App ===
MINIAPP_URL={{ yusic_stack_miniapp_url }}
MINIAPP_SECRET_KEY={{ yusic_stack_miniapp_secret_key }}
MINIAPP_ENABLED_PROVIDERS={{ yusic_stack_miniapp_enabled_providers }}

# === SoundCloud ===
SOUNDCLOUD_SERVICE_URL_PRIMARY={{ yusic_stack_soundcloud_service_url_primary }}
SOUNDCLOUD_SERVICE_URL_FALLBACK={{ yusic_stack_soundcloud_service_url_fallback }}
SOUNDCLOUD_FALLBACK_POLICY={{ yusic_stack_soundcloud_fallback_policy }}
SOUNDCLOUD_PROVIDER_TOKEN={{ yusic_stack_soundcloud_provider_token }}
SOUNDCLOUD_FALLBACK_TIMEOUT_SECONDS={{ yusic_stack_soundcloud_fallback_timeout_seconds }}

# === Provider auth ===
PROVIDER_TOKEN={{ yusic_stack_provider_token }}
YANDEX_TOKEN={{ yusic_stack_yandex_token }}

# === Redis ===
REDIS_BIND_IP={{ yusic_stack_redis_bind_ip }}
REDIS_PORT={{ yusic_stack_redis_port }}
REDIS_PASSWORD={{ yusic_stack_redis_password }}
REDIS_URL=redis://{% if yusic_stack_redis_password %}:{{ yusic_stack_redis_password }}@{% endif %}redis:{{ yusic_stack_redis_port }}/0

# === Distributed processing ===
DISTRIBUTED_PROCESSING_ENABLED={{ yusic_stack_distributed_processing_enabled }}
COORDINATOR_URL={{ yusic_stack_coordinator_url }}
COORDINATOR_TIMEOUT_SECONDS={{ yusic_stack_coordinator_timeout_seconds }}
WORKER_ID={{ yusic_stack_worker_id }}
WORKER_TAGS={{ yusic_stack_worker_tags }}
WORKER_MAX_CONCURRENT_JOBS={{ yusic_stack_worker_max_concurrent_jobs }}

# === Telegram CDN relay (yusic-pdh fix lives here) ===
TELEGRAM_RELAY_URLS={{ yusic_stack_telegram_relay_urls | join(',') }}
TELEGRAM_RELAY_MODE={{ yusic_stack_telegram_relay_mode }}
TELEGRAM_RELAY_TOTAL_BUDGET_MS={{ yusic_stack_telegram_relay_total_budget_ms }}
TELEGRAM_RELAY_PER_ATTEMPT_TIMEOUT_MS={{ yusic_stack_telegram_relay_per_attempt_timeout_ms }}
TELEGRAM_RELAY_DEAD_TTL_SECONDS={{ yusic_stack_telegram_relay_dead_ttl_seconds }}
TELEGRAM_RELAY_STICKY_TTL_SECONDS={{ yusic_stack_telegram_relay_sticky_ttl_seconds }}

# === Outbound proxies ===
TELEGRAM_PROXY_URL={{ yusic_stack_telegram_proxy_url }}
SOUNDCLOUD_PROXY_URL={{ yusic_stack_soundcloud_proxy_url }}

# === Cache bot ===
CACHE_BOT_TOKEN={{ yusic_stack_cache_bot_token }}
