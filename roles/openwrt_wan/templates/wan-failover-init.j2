#!/bin/sh /etc/rc.common

START={{ openwrt_wan_boot_try_dhcp_start_priority | int }}
STOP=10

SERVICE_NAME="{{ openwrt_wan_boot_try_dhcp_service_name }}"

. /lib/functions.sh

log_msg() {
	logger -t "${SERVICE_NAME}" "$*"
}

append_dns() {
	local dns="$1"
	[ -n "${dns}" ] || return 0
	if [ -n "${CFG_FALLBACK_DNS}" ]; then
		CFG_FALLBACK_DNS="${CFG_FALLBACK_DNS} ${dns}"
	else
		CFG_FALLBACK_DNS="${dns}"
	fi
}

load_settings() {
	config_load "${SERVICE_NAME}"

	config_get CFG_ENABLED main enabled "1"
	config_get CFG_WAN_IF main wan_interface "wan"
	config_get CFG_WAN_DEV main wan_device "eth0"

	config_get CFG_FALLBACK_PROTO main fallback_proto "dhcp"
	config_get CFG_FALLBACK_IPADDR main fallback_ipaddr ""
	config_get CFG_FALLBACK_NETMASK main fallback_netmask ""
	config_get CFG_FALLBACK_GATEWAY main fallback_gateway ""
	config_get CFG_FALLBACK_PPPOE_USERNAME main fallback_pppoe_username ""
	config_get CFG_FALLBACK_PPPOE_PASSWORD main fallback_pppoe_password ""
	config_get CFG_FALLBACK_PPPOE_IPV6 main fallback_pppoe_ipv6 "auto"

	config_get CFG_DHCP_WAIT_SEC main dhcp_wait_sec "35"
	config_get CFG_PROBE_HOST main probe_host "1.1.1.1"
	config_get CFG_PROBE_COUNT main probe_count "2"

	CFG_FALLBACK_DNS=""
	config_list_foreach main fallback_dns append_dns
}

uci_set_if_needed() {
	local key="$1"
	local value="$2"
	local current

	current="$(uci -q get "${key}" || true)"
	if [ "${current}" != "${value}" ]; then
		uci set "${key}=${value}"
		UCI_CHANGED='1'
	fi
}

uci_delete_if_present() {
	local key="$1"
	if uci -q get "${key}" >/dev/null 2>&1; then
		uci -q delete "${key}"
		UCI_CHANGED='1'
	fi
}

apply_dns() {
	local iface="$1"
	local dns_values="$2"
	local current_dns
	local dns

	current_dns="$(uci -q get "network.${iface}.dns" 2>/dev/null | sed 's/[[:space:]]*$//')"
	if [ -n "${dns_values}" ]; then
		uci_set_if_needed "network.${iface}.peerdns" "0"
		if [ "${current_dns}" != "${dns_values}" ]; then
			uci_delete_if_present "network.${iface}.dns"
			for dns in ${dns_values}; do
				uci add_list "network.${iface}.dns=${dns}"
			done
			UCI_CHANGED='1'
		fi
	else
		uci_set_if_needed "network.${iface}.peerdns" "1"
		uci_delete_if_present "network.${iface}.dns"
	fi
}

reload_network() {
	/etc/init.d/network reload >/dev/null 2>&1 || /etc/init.d/network restart >/dev/null 2>&1 || true
}

apply_dhcp_profile() {
	UCI_CHANGED='0'

	uci_set_if_needed "network.${CFG_WAN_IF}.device" "${CFG_WAN_DEV}"
	uci_set_if_needed "network.${CFG_WAN_IF}.proto" "dhcp"
	uci_delete_if_present "network.${CFG_WAN_IF}.ipaddr"
	uci_delete_if_present "network.${CFG_WAN_IF}.netmask"
	uci_delete_if_present "network.${CFG_WAN_IF}.gateway"
	uci_delete_if_present "network.${CFG_WAN_IF}.username"
	uci_delete_if_present "network.${CFG_WAN_IF}.password"
	uci_delete_if_present "network.${CFG_WAN_IF}.ipv6"
	apply_dns "${CFG_WAN_IF}" ""

	if [ "${UCI_CHANGED}" = "1" ]; then
		uci commit network
	fi
	reload_network
}

apply_fallback_profile() {
	UCI_CHANGED='0'

	uci_set_if_needed "network.${CFG_WAN_IF}.device" "${CFG_WAN_DEV}"
	uci_set_if_needed "network.${CFG_WAN_IF}.proto" "${CFG_FALLBACK_PROTO}"

	case "${CFG_FALLBACK_PROTO}" in
		dhcp)
			uci_delete_if_present "network.${CFG_WAN_IF}.ipaddr"
			uci_delete_if_present "network.${CFG_WAN_IF}.netmask"
			uci_delete_if_present "network.${CFG_WAN_IF}.gateway"
			uci_delete_if_present "network.${CFG_WAN_IF}.username"
			uci_delete_if_present "network.${CFG_WAN_IF}.password"
			uci_delete_if_present "network.${CFG_WAN_IF}.ipv6"
			apply_dns "${CFG_WAN_IF}" ""
			;;
		static)
			[ -n "${CFG_FALLBACK_IPADDR}" ] || return 1
			[ -n "${CFG_FALLBACK_NETMASK}" ] || return 1
			uci_set_if_needed "network.${CFG_WAN_IF}.ipaddr" "${CFG_FALLBACK_IPADDR}"
			uci_set_if_needed "network.${CFG_WAN_IF}.netmask" "${CFG_FALLBACK_NETMASK}"
			if [ -n "${CFG_FALLBACK_GATEWAY}" ]; then
				uci_set_if_needed "network.${CFG_WAN_IF}.gateway" "${CFG_FALLBACK_GATEWAY}"
			else
				uci_delete_if_present "network.${CFG_WAN_IF}.gateway"
			fi
			uci_delete_if_present "network.${CFG_WAN_IF}.username"
			uci_delete_if_present "network.${CFG_WAN_IF}.password"
			uci_delete_if_present "network.${CFG_WAN_IF}.ipv6"
			apply_dns "${CFG_WAN_IF}" "${CFG_FALLBACK_DNS}"
			;;
		pppoe)
			[ -n "${CFG_FALLBACK_PPPOE_USERNAME}" ] || return 1
			[ -n "${CFG_FALLBACK_PPPOE_PASSWORD}" ] || return 1
			uci_set_if_needed "network.${CFG_WAN_IF}.username" "${CFG_FALLBACK_PPPOE_USERNAME}"
			uci_set_if_needed "network.${CFG_WAN_IF}.password" "${CFG_FALLBACK_PPPOE_PASSWORD}"
			uci_set_if_needed "network.${CFG_WAN_IF}.ipv6" "${CFG_FALLBACK_PPPOE_IPV6}"
			uci_delete_if_present "network.${CFG_WAN_IF}.ipaddr"
			uci_delete_if_present "network.${CFG_WAN_IF}.netmask"
			uci_delete_if_present "network.${CFG_WAN_IF}.gateway"
			apply_dns "${CFG_WAN_IF}" "${CFG_FALLBACK_DNS}"
			;;
		*)
			return 1
			;;
	esac

	if [ "${UCI_CHANGED}" = "1" ]; then
		uci commit network
	fi
	reload_network
	return 0
}

dhcp_online() {
	local wait_left
	local probe_left

	wait_left="${CFG_DHCP_WAIT_SEC}"
	while [ "${wait_left}" -gt 0 ]; do
		if ifstatus "${CFG_WAN_IF}" 2>/dev/null | grep -q '"up": true'; then
			probe_left="${CFG_PROBE_COUNT}"
			while [ "${probe_left}" -gt 0 ]; do
				if ping -c 1 -W 2 "${CFG_PROBE_HOST}" >/dev/null 2>&1; then
					return 0
				fi
				probe_left=$((probe_left - 1))
			done
		fi
		sleep 1
		wait_left=$((wait_left - 1))
	done

	return 1
}

write_last_mode() {
	printf '%s\n' "$1" > "/tmp/${SERVICE_NAME}.last"
}

start() {
	load_settings

	if [ "${CFG_ENABLED}" != "1" ]; then
		log_msg "disabled"
		return 0
	fi

	log_msg "start: try DHCP on ${CFG_WAN_IF}/${CFG_WAN_DEV}"
	apply_dhcp_profile

	if dhcp_online; then
		write_last_mode "dhcp"
		log_msg "DHCP ok on ${CFG_WAN_IF}, keeping DHCP"
		return 0
	fi

	log_msg "DHCP failed on ${CFG_WAN_IF}, applying fallback proto=${CFG_FALLBACK_PROTO}"
	if apply_fallback_profile; then
		write_last_mode "${CFG_FALLBACK_PROTO}"
		log_msg "fallback applied: ${CFG_FALLBACK_PROTO}"
		return 0
	fi

	log_msg "fallback apply failed"
	return 1
}
