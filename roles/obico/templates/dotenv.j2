# Managed by Ansible role obico. Do not edit.
SITE_USES_HTTPS={{ 'True' if obico_site_using_https else 'False' }}
SITE_URL={{ obico_site_url }}

EMAIL_HOST={{ obico_email_host }}
EMAIL_PORT={{ obico_email_port }}
EMAIL_USE_TLS={{ 'True' if obico_email_use_tls else 'False' }}
EMAIL_HOST_USER={{ obico_email_host_user }}
EMAIL_HOST_PASSWORD={{ lookup('env', obico_email_host_password_env) | default('', true) }}
DEFAULT_FROM_EMAIL={{ obico_email_default_from }}

TELEGRAM_BOT_TOKEN={{ lookup('env', obico_telegram_bot_token_env) | default('', true) }}

{% if not obico_self_host_ml %}
# Use Obico's hosted ML detector (free) instead of running it locally.
ML_API_HOST=https://app.obico.io
{% endif %}
