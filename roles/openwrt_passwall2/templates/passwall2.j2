# Managed by Ansible: openwrt_passwall2

config shunt_rules 'Block'
	option remarks 'Block'
	option network 'tcp,udp'
	option domain_list ''

config shunt_rules 'Direct'
	option remarks 'Direct'
	option network 'tcp,udp'
	option domain_list '{{ passwall2_profile_effective.direct_domains | join("\n") }}'
	option ip_list '{{ passwall2_profile_effective.direct_ip_list }}'

config shunt_rules 'Ban_RU'
	option remarks 'Ban_RU'
	option network 'tcp,udp'
	option domain_list '{{ passwall2_profile_effective.ban_ru_domains | join("\n") }}'

config shunt_rules 'Proxy'
	option remarks 'Proxy'
	option network 'tcp,udp'
	option domain_list '{{ passwall2_profile_effective.proxy_domains | join("\n") }}'
	option ip_list '{{ passwall2_profile_effective.proxy_ip_list }}'

config nodes 'uOEn2cRl'
	option remarks 'Shunt'
	option type 'Xray'
	option protocol '_shunt'
	option Direct '_direct'
	option Ban_RU 'CIQdys6h'
	option Proxy 'QA84CBXY'
	option default_node 'QA84CBXY'
	option domainStrategy 'IPIfNonMatch'
	option domainMatcher 'hybrid'
	option preproxy_enabled '0'
	option Block '_blackhole'

config nodes 'QA84CBXY'
	option remarks 'Balance'
	option type 'Xray'
	option protocol '_balancing'
	option balancingStrategy 'leastPing'
	option probeInterval '1m'
	option useCustomProbeUrl '1'
	option probeUrl '{{ passwall2_probe_url }}'
	list balancing_node 'oeG6f2Ku'

config global
	option enabled '{{ passwall2_profile_effective.enabled }}'
	option node_socks_port '{{ passwall2_socks_port }}'
	option localhost_proxy '1'
	option client_proxy '1'
	option socks_enabled '0'
	option acl_enable '{{ passwall2_profile_effective.acl_enable }}'
	option node 'uOEn2cRl'
	option direct_dns_protocol 'auto'
	option direct_dns_query_strategy 'UseIP'
	option remote_dns_protocol 'doh'
	option remote_dns_query_strategy 'UseIPv4'
	option dns_hosts '{{ passwall2_profile_effective.dns_hosts | join("\n") }}'
	option log_node '1'
	option loglevel '{{ passwall2_profile_effective.loglevel }}'
	option write_ipset_direct '1'
	option remote_dns_detour 'remote'
	option remote_fakedns '0'
	option dns_redirect '1'
	option remote_dns_doh '{{ passwall2_profile_effective.remote_dns_doh }}'

config global_haproxy
	option balancing_enable '0'

config global_delay
	option start_daemon '1'
	option start_delay '60'

config global_forwarding
	option tcp_no_redir_ports 'disable'
	option udp_no_redir_ports 'disable'
	option tcp_redir_ports '{{ passwall2_profile_effective.tcp_redir_ports }}'
	option udp_redir_ports '{{ passwall2_profile_effective.udp_redir_ports }}'
	option accept_icmp '0'
	option use_nft '1'
	option tcp_proxy_way 'redirect'
	option ipv6_tproxy '0'

config global_xray
	option sniffing_override_dest '0'

config global_other
	option auto_detection_time '0'

config global_rules
	option geosite_update '1'
	option geoip_update '1'
	option v2ray_location_asset '/usr/share/v2ray/'
	option geoip_url '{{ passwall2_geoip_url_v2ray }}'
	option geosite_url '{{ passwall2_geosite_url_v2ray }}'
	option enable_geoview '0'
	option auto_update '1'
	option week_update '7'
	option time_update '2'

config global_app
	option xray_file '/usr/bin/xray'
	option hysteria_file '/usr/bin/hysteria'
	option sing_box_file '/usr/bin/sing-box'

config global_subscribe
	option filter_keyword_mode '1'
	option ss_type 'shadowsocks-rust'
	option trojan_type 'sing-box'
	option vmess_type 'xray'
	option vless_type 'xray'
	option hysteria2_type 'sing-box'

config global_singbox
	option sniff_override_destination '0'
	option geoip_path '/usr/share/singbox/geoip.db'
	option geoip_url '{{ passwall2_geoip_url_singbox }}'
	option geosite_path '/usr/share/singbox/geosite.db'
	option geosite_url '{{ passwall2_geosite_url_singbox }}'

config subscribe_list
	option remark 'Watchdog'
	option url '{{ passwall2_subscribe_url }}'
	option allowInsecure '0'
	option filter_keyword_mode '5'
	option ss_type 'global'
	option trojan_type 'global'
	option vmess_type 'global'
	option vless_type 'global'
	option hysteria2_type 'global'
	option domain_strategy 'global'
	option auto_update '1'
	option week_update '8'
	option interval_update '1'
	option user_agent 'Passwall2/OpenWrt'
