# Managed by Ansible role rclone_serve. Do not edit.
RCLONE_PROTOCOL={{ instance.protocol }}
RCLONE_REMOTE={{ instance.remote }}
RCLONE_ADDR={{ instance.bind_address | default(rclone_serve_bind_address) }}:{{ instance.port }}
{% if instance.user is defined and instance.pass is defined %}
RCLONE_AUTH_ARGS=--user {{ instance.user | quote }} --pass {{ instance.pass | quote }}
{% else %}
RCLONE_AUTH_ARGS=
{% endif %}
RCLONE_EXTRA_ARGS={{ (instance.extra_args | default([])) | join(' ') }}
