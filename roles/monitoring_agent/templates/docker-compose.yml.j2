# NOTE: the restart policy below only covers container *exits*. When dockerd restores
# containers at boot and the start itself fails (published port on an address tailscaled
# has not assigned yet), the restart manager does not retry - see
# roles/monitoring_agent/templates/monitoring-agent.service.j2, which owns that retry.
services:
{% if monitoring_agent_enable_node_exporter | bool %}
  node_exporter:
    image: {{ monitoring_agent_node_exporter_image }}
    container_name: monitoring-node-exporter
    restart: unless-stopped
    command:
      - --path.rootfs=/host
    volumes:
      - /:/host:ro,rslave
    ports:
      - "{{ monitoring_agent_bind_address }}:{{ monitoring_agent_node_exporter_port }}:9100"
{% endif %}
{% if monitoring_agent_enable_cadvisor | bool %}

  cadvisor:
    image: {{ monitoring_agent_cadvisor_image }}
    container_name: monitoring-cadvisor
    restart: unless-stopped
    privileged: true
    devices:
      - /dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:rw
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
    ports:
      - "{{ monitoring_agent_bind_address }}:{{ monitoring_agent_cadvisor_port }}:8080"
{% endif %}
