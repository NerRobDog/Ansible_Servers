{% if monitoring_stack_alert_telegram_enabled | bool %}
route:
  receiver: telegram
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  # State-change model: one message when an alert starts firing, one "resolved"
  # when it clears (send_resolved below). While an incident stays open we re-notify
  # every repeat_interval so a host that is still down for hours is not forgotten —
  # not a per-scrape stream.
  repeat_interval: 6h

# When a host is unreachable its node-exporter scrape fails first; cadvisor,
# memory, load and disk alerts for the same host are then just noise restating
# "this host is down". Collapse them into the single NodeExporterDown message.
# instance is the host alias (host.key, no port) on every fleet job, so matching
# on instance lines the alerts up across exporters.
inhibit_rules:
  - source_matchers:
      - 'alertname = "FleetNodeExporterDown"'
    target_matchers:
      - 'alertname =~ "FleetCadvisorDown|FleetHighMemoryUsage|FleetHighLoad|FleetDiskAlmostFull"'
    equal: ["instance"]

receivers:
  - name: telegram
    telegram_configs:
      - send_resolved: true
        bot_token: {{ monitoring_stack_alert_telegram_bot_token | to_json }}
        chat_id: {{ monitoring_stack_alert_telegram_chat_id | int }}
{% if (monitoring_stack_alert_telegram_topic_id | default('') | string | trim) | length > 0 %}
        message_thread_id: {{ monitoring_stack_alert_telegram_topic_id | int }}
{% endif %}
        parse_mode: HTML
        message: |-
          {% raw %}{{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname }}</b> ({{ .Status }})
          {{ range .Alerts }}<b>{{ .Labels.instance }}</b> — {{ .Annotations.summary }}
          {{ .Annotations.description }}
          {{ end }}{% endraw %}
{% else %}
# Telegram delivery is disabled: set monitoring_stack_alert_telegram_enabled
# plus bot token and chat id to make alerts leave this host. Until then alerts
# fire in Prometheus and stop here.
route:
  receiver: default

receivers:
  - name: default
{% endif %}
