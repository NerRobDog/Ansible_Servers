global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/openwrt-alerts.yml
  - /etc/prometheus/fleet-alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]

{% if monitoring_stack_enable_logs | bool %}
  - job_name: loki
    metrics_path: /metrics
    static_configs:
      - targets: ["loki:3100"]
{% endif %}

{% if monitoring_stack_scrape_fleet_agents | bool %}
  - job_name: monitoring-node-exporter
{% if monitoring_stack_scrape_hosts | length > 0 %}
    static_configs:
{% for host in monitoring_stack_scrape_hosts %}
{%   set _bind = host.value.monitoring.agent_bind_address | default('') %}
{%   set _scrape_addr = host.value.monitoring.scrape_address | default((_bind not in ['', '0.0.0.0', '127.0.0.1']) | ternary(_bind, host.value.ansible_host)) %}
      - targets: ["{{ _scrape_addr }}:{{ host.value.monitoring.agent_node_exporter_port | default(monitoring_agent_node_exporter_port) }}"]
        labels:
          instance: "{{ host.key }}"
{% endfor %}
{% else %}
    static_configs: []
{% endif %}

  - job_name: monitoring-cadvisor
{% if monitoring_stack_scrape_hosts | length > 0 %}
    static_configs:
{% for host in monitoring_stack_scrape_hosts %}
{%   set _bind = host.value.monitoring.agent_bind_address | default('') %}
{%   set _scrape_addr = host.value.monitoring.scrape_address | default((_bind not in ['', '0.0.0.0', '127.0.0.1']) | ternary(_bind, host.value.ansible_host)) %}
      - targets: ["{{ _scrape_addr }}:{{ host.value.monitoring.agent_cadvisor_port | default(monitoring_agent_cadvisor_port) }}"]
        labels:
          instance: "{{ host.key }}"
{% endfor %}
{% else %}
    static_configs: []
{% endif %}
{% endif %}

{% if monitoring_stack_scrape_openwrt_agents | bool %}
  - job_name: monitoring-openwrt-node-exporter
{% if monitoring_stack_openwrt_scrape_hosts | length > 0 %}
    metrics_path: /metrics
    static_configs:
{% for host in monitoring_stack_openwrt_scrape_hosts %}
      - targets: ["{{ host.value.ansible_host }}:{{ host.value.monitoring.openwrt_node_exporter_port | default(openwrt_node_exporter_port) }}"]
        labels:
          instance: "{{ host.key }}"
{% endfor %}
{% else %}
    static_configs: []
{% endif %}
{% endif %}
