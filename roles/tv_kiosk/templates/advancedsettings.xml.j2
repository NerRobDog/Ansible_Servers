<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by Ansible role tv_kiosk. Do not edit. -->
<advancedsettings>
  <!-- Enable Kodi's web interface so other tools can poke it via JSON-RPC.
       Bound to 0.0.0.0 — gate via host firewall. -->
  <services>
    <webserver>true</webserver>
    <webserverport>8080</webserverport>
    <webserverauthentication>false</webserverauthentication>
    <esenabled>true</esenabled>
    <upnp>true</upnp>
    <upnpserver>true</upnpserver>
    <zeroconf>true</zeroconf>
  </services>
</advancedsettings>
